# Copy to `.env` for local dev. Only `VITE_*` keys are exposed to the client bundle.
# Never commit real secrets — they would be visible in the built assets.

# Shown on the chat view and used as the default document title when set.
VITE_APP_TITLE=Signal Foundry

# Agent API (see runtime agent OpenAPI).
# Recommended for `npm run dev`: same-origin base path `/api/v1/runtime/` — Vite `server.proxy` forwards to the runtime
# (default target `http://127.0.0.1:4501`; see `vite.config.ts`). Avoids CORS during local development.
# For `vite preview` or static hosting, use a full URL if CORS allows, or deploy same-origin.
VITE_AGENT_API_BASE_URL=/api/v1/runtime/

# Local HTTPS is opt-in. See ../../docs/local-https.md for certificate generation and startup.
# Vite uses the root APP_HTTPSERVER_TLS_CERTFILE and APP_HTTPSERVER_TLS_KEYFILE
# values when these optional VITE_ path overrides are unset. VITE_LOCAL_HTTPS must
# remain explicitly enabled.
# VITE_LOCAL_HTTPS=true
# Optional path overrides for Vite only:
# VITE_LOCAL_HTTPS_CERT_FILE=../../.local-https/localhost.pem
# VITE_LOCAL_HTTPS_KEY_FILE=../../.local-https/localhost-key.pem
