{
  "name": "signal-foundry",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["install-deps"],
      "inputs": ["default", "golangci"],
      "options": {
        "command": "make lint",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make test",
        "cwd": "{projectRoot}"
      }
    },
    "install-deps": {
      "cache": true,
      "options": {
        "command": "go mod download",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "install-deps",
        {
          "projects": ["signal-ui"],
          "target": "install-deps"
        }
      ],
      "inputs": [
        "default",
        "{workspaceRoot}/apps/signal-ui/src/**/*",
        "{workspaceRoot}/apps/signal-ui/public/**/*",
        "{workspaceRoot}/apps/signal-ui/index.html",
        "{workspaceRoot}/apps/signal-ui/package.json",
        "{workspaceRoot}/apps/signal-ui/package-lock.json",
        "{workspaceRoot}/apps/signal-ui/*.config.*",
        "{workspaceRoot}/apps/signal-ui/tsconfig*.json",
        "{workspaceRoot}/apps/signal-ui/vite.config.ts",
        "{workspaceRoot}/apps/signal-ui/Makefile"
      ],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "make dist/bin",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "dependsOn": ["install-deps"],
      "options": {
        "command": "go run ./cmd/signal-foundry start --json-logs | pino-pretty",
        "cwd": "{projectRoot}"
      }
    }
  }
}
