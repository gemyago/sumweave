# Use this file to configure crew-manager generated surfaces.
# Copy it to .agents/prompts/crew-manager/config.yaml and modify the configuration.
# manager.model: short label for delegation messages in prompt-driven environments
# manager.opencode_model: fully-qualified OpenCode model (provider/model)
# Each sub-agent role must have a matching instruction file:
#   .agents/prompts/crew-manager/agent-<role>.md
# After editing, run: .agents/prompts/crew-manager/setup.sh
manager:
  agent_name: crew-manager
  description: General purpose orchestrator agent for coordinating tasks and workflows.
  model: gpt-5.6-sol
  opencode_model: openai/gpt-5.6-sol
  reasoning_effort: high
sub-agents:
  p1-buddy:
    sub_agent_name: crew-p1-buddy
    description: P1 entry level software engineer. Best for simple, bounded tasks.
    model: gpt-5.3-codex-spark
    opencode_model: openai/gpt-5.3-codex-spark
    reasoning_effort: high
  p2-buddy:
    sub_agent_name: crew-p2-buddy
    description: P2 software engineer for small coding tasks and focused investigation.
    model: gpt-5.6-luna
    opencode_model: openai/gpt-5.6-luna
    reasoning_effort: high
  p3-buddy:
    sub_agent_name: crew-p3-buddy
    description: P3 software engineer for ordinary implementation work with clear scope.
    model: gpt-5.6-terra
    opencode_model: openai/gpt-5.6-terra
    reasoning_effort: medium
  p4-buddy:
    sub_agent_name: crew-p4-buddy
    description: P4 software engineer for complex debugging, planning, and review.
    model: gpt-5.6-terra
    opencode_model: openai/gpt-5.6-terra
    reasoning_effort: high
  p5-buddy:
    sub_agent_name: crew-p5-buddy
    description: P5 principal software engineer for the hardest technical work.
    model: gpt-5.6-sol
    opencode_model: openai/gpt-5.6-sol
    reasoning_effort: high
