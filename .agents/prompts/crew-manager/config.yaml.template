# Use this file to configure crew-manager generated surfaces.
# Copy it to config.yaml in this directory and modify the configuration.
# manager.model: short label for delegation messages in prompt-driven environments
# manager.opencode_model: fully-qualified OpenCode model (provider/model)
# After editing, run setup.sh from this directory.
manager:
  agent_name: crew-manager
  description: General purpose orchestrator agent for coordinating tasks and workflows.
  model: gpt-5.6-sol
  opencode_model: openai/gpt-5.6-sol
  reasoning_effort: medium
  delegation_policy:
    - Choose the agent profile by the kind of reasoning that dominates the task, then choose medium or high effort within that profile family.
    - Route by agent name, description, and expected behavior; never route by the configured model or provider.
    - Use P2 for explicit bounded execution; use P2 High when that work needs more context or several precise steps.
    - Use P3 for convergent software engineering; use P3 High for difficult debugging, coupled components, correctness-sensitive work, or rigorous review.
    - Use P4 for synthesis, visual or product judgment, design exploration, and choosing among plausible approaches; use P4 High for major architecture, system-wide direction, or exceptional ambiguity.
    - Do not move to a different model family merely because a task is harder; prefer the high-effort profile in the appropriate family.
    - Assign temporary roles in each invocation instead of treating profiles as permanent job roles.
    - For independent verification, use a fresh P3 High invocation with an explicit read-only review assignment.
    - Require independent verification for security, concurrency, migrations, data integrity, public contracts, high blast radius, and P4 High work.
sub-agents:
  p2:
    sub_agent_name: crew-p2
    description: Execution profile for narrow, well-specified work whose target, implementation path, and verification method are explicit. Use for targeted edits, small fixes, focused tests, status checks, and precise information collection.
    model: gpt-5.6-luna
    opencode_model: openai/gpt-5.6-luna
    reasoning_effort: medium
  p2-high:
    sub_agent_name: crew-p2-high
    description: High-effort execution profile for bounded, well-specified work that remains explicit but requires more context, several precise steps, or more careful verification than P2. Avoid ambiguous investigation, architecture, and cross-system design.
    model: gpt-5.6-luna
    opencode_model: openai/gpt-5.6-luna
    reasoning_effort: high
  p3:
    sub_agent_name: crew-p3
    description: Engineering profile for normal implementation in a substantially understood problem space, including features, bug fixes, refactors, tests, endpoints, persistence, and precise UI implementation from an established design.
    model: gpt-5.6-terra
    opencode_model: openai/gpt-5.6-terra
    reasoning_effort: medium
  p3-high:
    sub_agent_name: crew-p3-high
    description: High-effort engineering profile for difficult debugging, unfamiliar code, coupled components, correctness-sensitive implementation, broad technical context, and rigorous independent review. The invocation defines whether to investigate, implement, or review.
    model: gpt-5.6-terra
    opencode_model: openai/gpt-5.6-terra
    reasoning_effort: high
  p4:
    sub_agent_name: crew-p4
    description: Synthesis profile for visual or product judgment, interaction and layout composition, design exploration, ambiguous requirements, and choosing among plausible approaches. Use P3 when the design is already substantially known.
    model: gpt-5.6-sol
    opencode_model: openai/gpt-5.6-sol
    reasoning_effort: medium
  p4-high:
    sub_agent_name: crew-p4-high
    description: High-effort synthesis profile for major architecture, system-wide direction, competing product or technical approaches, complex decomposition, and exceptional ambiguity where choosing what should be built is the primary challenge.
    model: gpt-5.6-sol
    opencode_model: openai/gpt-5.6-sol
    reasoning_effort: high
