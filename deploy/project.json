{
  "name": "sumweave-deploy",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {"command": "make -C deploy lint"}
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {"command": "make -C deploy lint render-production test"}
    }
  }
}
